{
  "name": "yuki-file-organizer",
  "version": "0.1.0",
  "private": true,
  "description": "Yuki file organizer desktop app built with React and Electron.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.0",
    "vite": "7.0.6",
    "typescript": "5.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.7.1"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "24.1.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "concurrently": "9.2.0",
    "cross-env": "10.0.0",
    "electron": "37.2.3",
    "eslint": "9.31.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "tailwindcss": "3.4.17",
    "wait-on": "8.0.4"
  }
}
